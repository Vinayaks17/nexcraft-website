# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# Web3Forms access key — delivers the /estimate form to the team inbox.
# Get one (free) at https://web3forms.com by entering the destination address.
#
# Public by design: the key only authorises delivery to the address it was
# registered with, so it is safe to ship in the client bundle. Without it the
# form refuses to submit and points the visitor at email instead.
NEXT_PUBLIC_WEB3FORMS_KEY=your-access-key-here
